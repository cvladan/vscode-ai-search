{
    "name": "ai-semantic-search",
    "displayName": "AI Search",
    "publisher": "jao",
    "description": "Semantic search and indexing for VS Code / VSCodium using embeddings, vector search and re-ranking.",
    "version": "0.2.4",
    "private": true,
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "code",
        "AI coding",
        "agent",
        "code search",
        "semantic search",
        "embeddings",
        "index",
        "search",
        "navigation"
    ],
    "icon": "resources/icon.png",
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "aiSearch.semanticSearch",
                "title": "Semantic Search",
                "category": "AI Search"
            },
            {
                "command": "aiSearch.indexCodebase",
                "title": "Index Codebase",
                "category": "AI Search"
            },
            {
                "command": "aiSearch.clearIndex",
                "title": "Clear Index",
                "category": "AI Search"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "aiSearch.semanticSearch",
                    "when": "editorHasSelection",
                    "group": "navigation@100"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aiSearchSidebar",
                    "title": "AI Search",
                    "icon": "./resources/activity_bar.svg"
                }
            ]
        },
        "views": {
            "aiSearchSidebar": [
                {
                    "id": "semanticSearchView",
                    "name": "AI Search",
                    "type": "webview"
                }
            ]
        },
        "configuration": {
            "title": "AI Search",
            "properties": {
                "aiSearch.embeddingProvider.provider": {
                    "type": "string",
                    "enum": [
                        "OpenAI",
                        "OpenRouter",
                        "VoyageAI",
                        "Ollama",
                        "Gemini"
                    ],
                    "default": "OpenAI",
                    "description": "Embedding service provider"
                },
                "aiSearch.embeddingProvider.model": {
                    "type": "string",
                    "description": "Embedding model to use"
                },
                "aiSearch.embeddingProvider.apiKey": {
                    "type": "string",
                    "description": "API key for the embedding provider"
                },
                "aiSearch.embeddingProvider.baseURL": {
                    "type": "string",
                    "description": "Custom API endpoint URL (optional)"
                },
                "aiSearch.embeddingProvider.host": {
                    "type": "string",
                    "description": "Ollama server host URL (optional)"
                },
                "aiSearch.embeddingProvider.keepAlive": {
                    "type": "string",
                    "description": "Keep model alive duration for Ollama (optional)"
                },
                "aiSearch.embeddingProvider.outputDimensionality": {
                    "type": "number",
                    "description": "Output dimension for Gemini embedding (supports Matryoshka representation: 3072, 1536, 768, 256)"
                },
                "aiSearch.vectorDatabase.provider": {
                    "type": "string",
                    "enum": [
                        "Milvus",
                        "LanceDB",
                        "Local"
                    ],
                    "enumDescriptions": [
                        "Milvus / Zilliz Cloud over the REST API (no local native modules required)",
                        "LanceDB embedded local database (recommended for local-only use)",
                        "Local FAISS + SQLite database stored on disk"
                    ],
                    "default": "Milvus",
                    "description": "Vector database backend. LanceDB and Local run fully on your machine and need no server."
                },
                "aiSearch.vectorDatabase.dataDir": {
                    "type": "string",
                    "description": "Storage directory for the local vector database (LanceDB/Local). Defaults to ~/.ai-search."
                },
                "aiSearch.reranker.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Re-rank vector search results with a dedicated rerank model for better relevance (second-stage retrieval)."
                },
                "aiSearch.reranker.provider": {
                    "type": "string",
                    "enum": [
                        "OpenRouter"
                    ],
                    "default": "OpenRouter",
                    "description": "Rerank provider. OpenRouter exposes Cohere rerank models via POST /api/v1/rerank."
                },
                "aiSearch.reranker.model": {
                    "type": "string",
                    "enum": [
                        "cohere/rerank-4-fast",
                        "cohere/rerank-4-pro",
                        "cohere/rerank-v3.5"
                    ],
                    "enumDescriptions": [
                        "Lowest latency, 32K context",
                        "Highest accuracy (SOTA), 32K context",
                        "Multilingual / semi-structured, 4K context"
                    ],
                    "default": "cohere/rerank-4-fast",
                    "description": "Rerank model id (you may also type a custom Cohere-compatible model)."
                },
                "aiSearch.reranker.apiKey": {
                    "type": "string",
                    "description": "API key for the rerank provider. If empty and the embedding provider is OpenRouter, that key is reused."
                },
                "aiSearch.reranker.baseURL": {
                    "type": "string",
                    "description": "Custom rerank endpoint base URL (optional). Defaults to https://openrouter.ai/api/v1."
                },
                "aiSearch.milvus.address": {
                    "type": "string",
                    "description": "Milvus server address (e.g., http://localhost:19530)"
                },
                "aiSearch.milvus.token": {
                    "type": "string",
                    "description": "Milvus authentication token (optional)"
                },
                "aiSearch.autoSync.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable automatic synchronization of workspace index every 5 minutes"
                },
                "aiSearch.autoSync.intervalMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 60,
                    "description": "Auto-sync interval in minutes (1-60). This runs periodic sync to keep the index updated."
                },
                "aiSearch.splitter.type": {
                    "type": "string",
                    "enum": [
                        "langchain",
                        "ast"
                    ],
                    "enumDescriptions": [
                        "Language-aware text splitter with support for multiple programming languages",
                        "AST-based code splitter that splits code by logical units (functions, classes, etc.)"
                    ],
                    "default": "ast",
                    "description": "Code splitter type to use for breaking down code into chunks"
                },
                "aiSearch.splitter.chunkSize": {
                    "type": "number",
                    "default": 1000,
                    "minimum": 100,
                    "maximum": 5000,
                    "description": "Maximum size of each code chunk in characters"
                },
                "aiSearch.splitter.chunkOverlap": {
                    "type": "number",
                    "default": 200,
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Number of overlapping characters between consecutive chunks"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run webpack",
        "compile": "npm run clean && tsc --build --force && node copy-assets.js",
        "webpack": "npm run clean && webpack --mode production && node copy-assets.js",
        "webpack:dev": "webpack --mode development && node copy-assets.js",
        "watch": "tsc -watch -p ./",
        "clean": "rimraf dist",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "typecheck": "tsc --noEmit",
        "package": "vsce package --no-dependencies",
        "release": "vsce publish --no-dependencies"
    },
    "dependencies": {
        "@ai-search/core": "*",
        "web-tree-sitter": "^0.25.6"
    },
    "devDependencies": {
        "@types/node": "20.x",
        "@types/vscode": "^1.74.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "@vscode/vsce": "^3.4.0",
        "copy-webpack-plugin": "^12.0.2",
        "eslint": "^9.25.1",
        "source-map-loader": "^5.0.0",
        "tree-sitter-wasms": "^0.1.11",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.3",
        "webpack": "^5.99.9",
        "webpack-cli": "^5.1.4"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cvladan/vscode-ai-search.git",
        "directory": "packages/vscode-extension"
    },
    "license": "MIT"
}
