{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build extension (dev)",
            "type": "shell",
            "command": "npm run build:core && npm run build:vscode",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Release (bump version, tag & push)",
            "type": "shell",
            "command": "bash scripts/release.sh ${input:releaseType}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "releaseType",
            "type": "pickString",
            "description": "Which part of the version to bump?",
            "options": [
                "patch",
                "minor",
                "major"
            ],
            "default": "patch"
        }
    ]
}
